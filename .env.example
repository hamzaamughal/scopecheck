# Copy to .env.local (local) or set in your host's environment settings (production).
# Every value is server-only. Never prefix credentials with NEXT_PUBLIC_.

# PostgreSQL 13+ connection string
DATABASE_URL=

# Better Auth: long random secret (e.g. `openssl rand -base64 32`). Keep it stable; changing it
# invalidates sessions and encrypted OAuth tokens.
BETTER_AUTH_SECRET=
# Public origin of the app, no trailing slash. Local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend: verification and password-reset email
RESEND_API_KEY=
# Must use a sender domain verified in Resend, e.g. ScopeCheck <noreply@yourdomain.com>
AUTH_EMAIL_FROM=

# OpenAI: AI assessments
OPENAI_API_KEY=
# Optional: AI attempts per user per UTC day (1-10000, default 10)
ASSESSMENT_DAILY_LIMIT=10
